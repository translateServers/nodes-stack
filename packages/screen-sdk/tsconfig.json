{
  "extends": "@nebula/typescript-config/react.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "declarationMap": false,
    "allowJs": true,
    "paths": {
      "@nebula/screen-component-sdk": ["../screen-component-sdk/dist/index.d.ts"],
      "@nebula/screen-component-sdk/*": ["../screen-component-sdk/dist/*.d.ts"],
      "@nebula/screen-editor-core": ["../screen-editor-core/dist/index.d.ts"],
      "@nebula/screen-editor-core/*": ["../screen-editor-core/dist/*.d.ts"],
      "@nebula/shared": ["../shared/dist/index.d.mts"]
    },
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "scripts/**/*.mjs",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
