{
  "name": "@nebula/screen-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auto-register": {
      "types": "./dist/auto-register.d.ts",
      "import": "./dist/auto-register.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./contracts/screen-document.schema.json": "./dist/contracts/screen-document.schema.json",
    "./contracts/screen-project-draft.schema.json": "./dist/contracts/screen-project-draft.schema.json",
    "./contracts/screen-project-envelope-input.schema.json": "./dist/contracts/screen-project-envelope-input.schema.json",
    "./contracts/screen-project-transfer.schema.json": "./dist/contracts/screen-project-transfer.schema.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/auto-register.js",
    "./dist/**/*.css"
  ],
  "scripts": {
    "build": "pnpm check:boundaries && vite build && node ./scripts/generate-json-schemas.mjs && node ./scripts/strip-virtual-module.mjs",
    "check:boundaries": "node ./scripts/check-boundaries.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@scena/react-ruler": "^0.19.0",
    "@tanstack/react-virtual": "^3.14.3",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "lucide-react": "^1.18.0",
    "radix-ui": "^1.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hotkeys-hook": "^5.3.3",
    "react-moveable": "^0.56.0",
    "react-selecto": "^1.26.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@microsoft/api-extractor": "^7.57.0",
    "@nebula/eslint-config": "workspace:*",
    "@nebula/shared": "workspace:*",
    "@nebula/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.18.0",
    "jsdom": "^29.1.1",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "unplugin-dts": "^1.0.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.9"
  }
}
