{
  "name": "@nebula/screen-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auto-register": {
      "types": "./dist/auto-register.d.ts",
      "import": "./dist/auto-register.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./contracts/screen-document.schema.json": "./dist/contracts/screen-document.schema.json",
    "./contracts/screen-project-draft.schema.json": "./dist/contracts/screen-project-draft.schema.json",
    "./contracts/screen-project-envelope-input.schema.json": "./dist/contracts/screen-project-envelope-input.schema.json",
    "./contracts/screen-project-transfer.schema.json": "./dist/contracts/screen-project-transfer.schema.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/auto-register.js",
    "./dist/**/*.css"
  ],
  "dependencies": {
    "zod": "^4.4.3"
  },
  "scripts": {
    "prebuild": "pnpm --filter @nebula/screen-editor-core build",
    "build": "pnpm check:boundaries && vite build && pnpm check:dist-boundaries && node ./scripts/generate-json-schemas.mjs && node ./scripts/normalize-declarations.mjs",
    "check:boundaries": "node ./scripts/check-boundaries.mjs",
    "check:dist-boundaries": "node ./scripts/check-dist-boundaries.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "eslint .",
    "size": "node ./scripts/measure-package-size.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:tarball": "node ./scripts/verify-tarball-consumer.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@microsoft/api-extractor": "^7.57.0",
    "@nebula/eslint-config": "workspace:*",
    "@nebula/screen-editor-core": "workspace:*",
    "@nebula/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.0",
    "@xyflow/react": "^12.11.2",
    "eslint": "^9.18.0",
    "jsdom": "^29.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "unplugin-dts": "^1.0.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.9"
  }
}
