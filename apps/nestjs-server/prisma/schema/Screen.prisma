model ScreenProject {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  canvas      String   @default("{}")
  components  String   @default("[]")
  /// Historical storage fields, read only by the document migration path.
  blueprint   String?
  /// Canonical serialized ScreenDocument.
  document    String?
  status      String   @default("draft")
  thumbnail   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  // 数据集管理 back-relation（见 Dataset.prisma）
  datasets           Dataset[]
  connections        DataSourceConnection[]
  datasetReferences  DatasetReference[]

  @@index([name])
  @@map("screen_projects")
}
