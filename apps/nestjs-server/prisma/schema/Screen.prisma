model ScreenProject {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  /// Canonical serialized ScreenDocument. Legacy columns remain in deployed
  /// databases until the BUS-approved destructive migration, but are not part
  /// of the active Prisma model or service read/write path.
  document    String
  status      String   @default("draft")
  thumbnail   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  // 数据集管理 back-relation（见 Dataset.prisma）
  datasets           Dataset[]
  connections        DataSourceConnection[]
  datasetReferences  DatasetReference[]

  @@index([name])
  @@map("screen_projects")
}
